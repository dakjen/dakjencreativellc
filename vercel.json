{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/dcre-onepagers",
      "destination": "/onepagers",
      "permanent": true
    },
    {
      "source": "/dcre-onepagers.html",
      "destination": "/onepagers",
      "permanent": true
    },
    {
      "source": "/dcre-onepagers/:file*",
      "destination": "/onepagers/:file*",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/dakotah#team",
      "permanent": false
    },
    {
      "source": "/team.html",
      "destination": "/dakotah#team",
      "permanent": false
    }
  ]
}
